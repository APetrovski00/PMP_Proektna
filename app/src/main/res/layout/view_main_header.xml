<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="28dp"
    android:paddingBottom="8dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/headerUserNameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/anonymous_user"
        android:textSize="22sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="14dp"
        android:background="@android:color/black" />

    <LinearLayout
        android:id="@+id/headerTabsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/jobsTab"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:minWidth="72dp"
            android:text="@string/jobs"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/jobsSeparator"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/header_separator"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/myCarsTab"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:minWidth="92dp"
            android:text="@string/owner_screen_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/profileSeparator"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/header_separator"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/profileTab"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:minWidth="92dp"
            android:text="@string/profile"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@android:color/black" />
</LinearLayout>
