<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="16dp"
        android:paddingEnd="48dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/worksheetTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/worksheet_screen_title"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/worksheetCarText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sample_car_one"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/worksheetPlateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/sample_plate_one"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/worksheetStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/status_ongoing"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/worksheetStartedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/started_sample"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/workDescriptionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/work_description"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/workDescriptionInput"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:hint="@string/work_description_hint"
            android:inputType="textMultiLine"
            android:padding="10dp" />

        <TextView
            android:id="@+id/photoOptionalText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/photo_optional"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addPhotoButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/add_photo"
            android:textAllCaps="false" />

        <ImageView
            android:id="@+id/photoPreviewImage"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/selected_photo"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deletePhotoButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/delete_photo"
            android:textAllCaps="false"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveNoteButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/save_note"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/finishWorkButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/finish_work"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
