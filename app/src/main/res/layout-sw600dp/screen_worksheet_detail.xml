<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="96dp"
        android:paddingTop="48dp"
        android:paddingEnd="96dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/worksheetDetailTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/worksheet_detail_title"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailCarText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/sample_car_one"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailPlateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/sample_plate_one"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/detailStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/status_finished"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailStartedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/started_sample"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/detailFinishedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/finished_sample"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/detailMechanicText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/sample_mechanic_one"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailWorkDoneLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/work_done"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@android:color/darker_gray" />

        <TextView
            android:id="@+id/detailWorkDoneText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sample_work_done_one"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/detailPhotoLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/photo"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/detailPhotoImage"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="10dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/photo"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/photoPlaceholderText"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="10dp"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:text="@string/photo_placeholder"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
