<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="96dp"
        android:paddingTop="48dp"
        android:paddingEnd="96dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/addCarTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_car_screen_title"
            android:textSize="32sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/licensePlateInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:hint="@string/license_plate"
            android:inputType="textCapCharacters"
            android:singleLine="true" />

        <EditText
            android:id="@+id/makeInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:hint="@string/make"
            android:inputType="textCapWords"
            android:singleLine="true" />

        <EditText
            android:id="@+id/modelInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:hint="@string/model"
            android:inputType="textCapWords"
            android:singleLine="true" />

        <EditText
            android:id="@+id/yearInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:hint="@string/year"
            android:inputType="number"
            android:maxLength="4"
            android:singleLine="true" />

        <EditText
            android:id="@+id/vinInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:hint="@string/vin"
            android:inputType="textCapCharacters"
            android:singleLine="true" />

        <EditText
            android:id="@+id/colorInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:hint="@string/color"
            android:inputType="textCapWords"
            android:singleLine="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveCarButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="@string/save_car"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelAddCarButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/cancel"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
